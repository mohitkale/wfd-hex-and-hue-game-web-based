# Rewarded-ad provider for the game: "none" (no ads; production default) or "mock"
# (fake countdown ad; development default). Real networks plug in behind the same interface.
PUBLIC_REWARDS=none

# Anonymous analytics (PostHog over plain HTTP, no SDK). Leave the key empty for no analytics at
# all; with a key, nothing is sent until the player agrees in the consent banner or Settings.
PUBLIC_POSTHOG_KEY=
# PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
