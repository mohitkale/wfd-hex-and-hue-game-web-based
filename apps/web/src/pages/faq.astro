---
import Page from "../layouts/Page.astro";

const faqs: { q: string; a: string }[] = [
  {
    q: "Is Hex & Hue really free?",
    a: "Yes. Every level is free to play, forever. There are no lives, no energy and no timers, and no level is ever locked behind a payment.",
  },
  {
    q: "Are there ads?",
    a: "Only ones you choose. You can choose to watch a short ad to play a level at double speed, but the game never shows forced ads, never needs one to win, and keeps working if an ad isn't available.",
  },
  {
    q: "How do I play?",
    a: "Tap a column to summon its front group. Its familiars fetch cubes of their colour from the picture, carry them to the portal and count the group's number down. A group with nothing it can reach waits in a slot until you free its colour. Deliver every cube to reveal the artwork. If every slot is full and a group has nowhere to wait, the level is lost: undo or retry.",
  },
  {
    q: "What happens if I get stuck?",
    a: "Retry is always free and instant. You can also use boosters (Undo, +1 Slot and Hint), which you earn by playing: clearing a picture pays coins, and every booster can be bought with them.",
  },
  {
    q: "Is every level solvable?",
    a: "Yes. Every level that ships is checked by a solver, so there is always a way to win from the start.",
  },
  {
    q: "Can I play offline or install it?",
    a: "Yes. Once you have opened the game, it keeps working without a connection. On most phones and computers you can install it from your browser's menu, and it launches like an app.",
  },
  {
    q: "Where is my progress saved?",
    a: "On your device, in your browser's storage. There is no account to create. Clearing your browser's site data will reset your progress.",
  },
  {
    q: "Is it accessible?",
    a: "The in-game Menu has color symbols (a shape for each color on the familiars and group badges), reduced motion, and switches for sound, music and vibration.",
  },
  {
    q: "Who makes the art?",
    a: "All art, names, lore and sounds in Hex & Hue are original. The moon, crystal and zodiac themes are made for the witchy, pagan and astrology-loving community.",
  },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Page
  title="FAQ: Hex & Hue"
  description="Answers about Hex & Hue: free to play, optional ads, how to play, offline play, saving and accessibility."
  jsonLd={jsonLd}
>
  <h1>Frequently asked questions</h1>
  <div class="prose">
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</Page>

<style>
  details {
    border-bottom: 1px solid rgb(201 184 255 / 0.15);
    padding: 4px 0;
  }
  summary {
    cursor: pointer;
    padding: 14px 0;
    font-weight: 600;
    font-size: 1.05rem;
  }
  details p {
    margin: 0 0 16px;
    color: var(--mist);
  }
</style>
