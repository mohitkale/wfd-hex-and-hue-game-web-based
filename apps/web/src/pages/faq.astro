---
import Page from "../layouts/Page.astro";

const faqs: { q: string; a: string }[] = [
  {
    q: "Is Hex & Hue really free?",
    a: "Yes. Every level is free to play, forever. There are no lives, no energy and no timers, and no level is ever locked behind a payment.",
  },
  {
    q: "Are there ads?",
    a: "Only ones you choose. A short, optional ad can unlock 3× speed for the level you are playing. The game never shows forced ads, and when no ad is available it simply carries on.",
  },
  {
    q: "How do I play?",
    a: "Tap the front box of a column. It moves into a tray and your familiars come out of it: each fetches one cube of the box's colour from the edge of the picture and carries it into the hole, and the box counts down. A box whose colour is still buried waits in its tray; if every tray is waiting, you are stuck (Retry is free, and an extra tray can rescue you). Clear every cube to reveal the picture.",
  },
  {
    q: "What happens if I get stuck?",
    a: "Retry is always free and instant. You can also use boosters, all earned by playing: an Extra Tray, Familiar's Call (bring a box to the front of its column), Besom Sweep (familiars fly over the picture to buried cubes), the Crystal Lantern (see every box still to come) and a Hint.",
  },
  {
    q: "Is every level solvable?",
    a: "Yes. Every level that ships is checked by a solver, so there is always a way to win from the start.",
  },
  {
    q: "Can I play offline or install it?",
    a: 'Yes. Once you have opened the game, it keeps working without a connection. On most phones and computers you can install it from your browser\'s menu ("Install app" or "Add to Home Screen"), and it launches like an app.',
  },
  {
    q: "Where is my progress saved?",
    a: "On your device, in your browser's storage. There is no account to create. Clearing your browser's site data will reset your progress.",
  },
  {
    q: "Is it accessible?",
    a: "Settings include color symbols (a shape for each color), reduced motion, and separate switches for sound effects, music and vibration.",
  },
  {
    q: "Who makes the art?",
    a: "All art, names, lore and sounds in Hex & Hue are original. The witch's journey (candles and brooms, herbs, crystals, the moon and stars, familiars and the grimoire) is made for the witchy, pagan and astrology-loving community.",
  },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Page
  title="FAQ: Hex & Hue"
  description="Answers about Hex & Hue: free to play, optional ads, how to play, offline play, saving and accessibility."
  jsonLd={jsonLd}
>
  <h1>Frequently asked questions</h1>
  <div class="prose">
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</Page>

<style>
  details {
    border-bottom: 1px solid rgb(201 184 255 / 0.15);
    padding: 4px 0;
  }
  summary {
    cursor: pointer;
    padding: 14px 0;
    font-weight: 600;
    font-size: 1.05rem;
  }
  details p {
    margin: 0 0 16px;
    color: var(--mist);
  }
</style>
