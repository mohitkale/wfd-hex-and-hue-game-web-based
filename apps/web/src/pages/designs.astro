---
import Base from "../layouts/Base.astro";
import { JOURNEY, dealMissed } from "@hexhue/game/journey";
import { artUrl } from "../lib/site";

/**
 * Every journey board as it is played, for the owner's review (M15.14). Not linked from anywhere,
 * not in the sitemap, not indexed: open /designs/ directly. Each card shows the board, its chapter
 * and tier, its size, cubes, colours and boxes, and a link that plays it.
 */
const boards = JOURNEY.map((e, i) => {
  const level = e.make();
  const sizes = level.columns.flat().map((g) => g.capacity);
  return {
    n: i + 1,
    id: e.id,
    name: e.name,
    chapter: `${e.chapter}. ${e.chapterName}`,
    tier: e.tier,
    size: `${level.width}×${level.height}`,
    cubes: level.cells.filter((c) => c >= 0).length,
    palette: level.palette,
    boxes: sizes.length,
    range: `${Math.min(...sizes)}–${Math.max(...sizes)}`,
    trays: level.slots,
    seals: level.seals?.length ?? 0,
    missed: dealMissed(e.id),
    lore: level.subject?.lore ?? "",
  };
});
---

<Base title="Board designs" description="Every journey board as played (review page)." noindex>
  <main class="designs">
    <h1>
      Board designs <small>{boards.length} levels, as played</small>
    </h1>
    <p class="note">
      Review page: not linked from the site. Tap a board's name to play it. Tell me the level number
      and what to change.
    </p>
    <div class="grid">
      {boards.map((b) => (
        <article class={`card ${b.tier}`}>
          <a href={`/play/?level=${b.id}`} class="art">
            <img src={artUrl(b.id)} alt={b.name} loading="lazy" />
          </a>
          <h2>
            <a href={`/play/?level=${b.id}`}>
              {b.n}. {b.name}
            </a>
            <span class="tier">{b.tier}</span>
          </h2>
          <p class="meta">Chapter {b.chapter}</p>
          <dl>
            <dt>Board</dt>
            <dd>{b.size}</dd>
            <dt>Cubes</dt>
            <dd>{b.cubes}</dd>
            <dt>Boxes</dt>
            <dd>
              {b.boxes} ({b.range})
            </dd>
            <dt>Trays</dt>
            <dd>{b.trays}</dd>
            <dt>Seals</dt>
            <dd>{b.seals > 0 ? "yes" : "no"}</dd>
            <dt>Difficulty</dt>
            <dd>{b.missed === null ? "on target" : "below target"}</dd>
          </dl>
          <p class="swatches">
            {b.palette.map((c) => (
              <span style={`background:${c}`} title={c} />
            ))}
          </p>
          <p class="lore">{b.lore}</p>
          <code>{b.id}</code>
        </article>
      ))}
    </div>
  </main>
</Base>

<style>
  .designs {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px;
  }
  h1 small {
    font-size: 0.5em;
    opacity: 0.7;
    margin-left: 8px;
  }
  .note {
    opacity: 0.8;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .card {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 12px;
    border-top: 4px solid #1f9e4a;
  }
  .card.medium {
    border-top-color: #2a6cf0;
  }
  .card.hard {
    border-top-color: #8a3fd6;
  }
  .card.extreme {
    border-top-color: #d2342b;
  }
  .art img {
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    border-radius: 6px;
    background: #faf4ec;
  }
  h2 {
    font-size: 1.05rem;
    margin: 8px 0 2px;
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }
  .tier {
    font-size: 0.7rem;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .meta,
  .lore {
    margin: 2px 0;
    font-size: 0.85rem;
    opacity: 0.8;
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 10px;
    font-size: 0.85rem;
    margin: 8px 0;
  }
  dt {
    opacity: 0.7;
  }
  dd {
    margin: 0;
  }
  .swatches {
    display: flex;
    gap: 3px;
    flex-wrap: wrap;
  }
  .swatches span {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }
  code {
    font-size: 0.75rem;
    opacity: 0.6;
  }
</style>
