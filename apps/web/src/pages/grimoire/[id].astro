---
import type { GrimoireEntry } from "@hexhue/learn";
import Page from "../../layouts/Page.astro";
import { BRANCH_INFO, builtLessons, isReviewed } from "../../lib/grimoire";

// Drafts get a page only in development and preview builds (lib/grimoire.ts).
export function getStaticPaths() {
  return builtLessons().map((entry) => ({ params: { id: entry.lesson.id }, props: { entry } }));
}

interface Props {
  entry: GrimoireEntry;
}
const { entry } = Astro.props;
const { lesson, safety } = entry;
const reviewed = isReviewed(entry);
const BADGE = {
  "kitchen-safe": "Safe to cook with",
  "external-only": "External use only",
  "do-not-use": "Toxic: do not use",
} as const;
---

<Page
  title={`${lesson.title} · The Grimoire · Hex & Hue`}
  description={reviewed ? lesson.intro : "A Grimoire lesson in review."}
  noindex={!reviewed}
  offline
>
  <div class="grimoire">
    <p class="crumb">
      <a href="/grimoire/">The Grimoire</a> · {BRANCH_INFO[lesson.branch].name}
    </p>
    <h1>{lesson.title}</h1>

    <div class="body">
      {!reviewed && <p class="draft-note">Draft: not yet reviewed by a practitioner.</p>}
      <p class="meta">
        {lesson.minutes} min · {lesson.steps.length} steps
      </p>
      <p class="lede">{lesson.intro}</p>

      {safety.fire && (
        <aside class="safety" aria-label="Fire safety">
          <strong>Fire safety.</strong> {safety.fire}
        </aside>
      )}
      {safety.herbs && safety.herbs.length > 0 && (
        <aside class="safety" aria-label="Herb safety">
          <strong>Herbs in this lesson.</strong>
          <ul>
            {safety.herbs.map((h) => (
              <li>
                {h.name}: <span class:list={["herb", h.safety]}>{BADGE[h.safety]}</span>
              </li>
            ))}
          </ul>
        </aside>
      )}

      {entry.altar && (
        <div class="begin" data-begin data-entry={JSON.stringify(entry)}>
          <button type="button" class="begin-button" data-open>
            Rehearse at the altar
          </button>
          <p class="begin-note" data-resume hidden>
            You can carry on where you left off.
          </p>
        </div>
      )}
      <h2 class="read-title">Read it through</h2>
      <ol class="steps">
        {lesson.steps.map((s) => (
          <li>
            <p class="prompt">{s.prompt}</p>
            <p class="why">{s.why}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</Page>

<script>
  import type { GrimoireEntry } from "@hexhue/learn";
  import { loadPractice } from "../../lib/practiceStore";

  const begin = document.querySelector<HTMLElement>("[data-begin]");
  const open = begin?.querySelector<HTMLButtonElement>("[data-open]");
  if (begin && open) {
    const entry = JSON.parse(begin.dataset.entry ?? "null") as GrimoireEntry | null;
    if (entry && loadPractice().runs[entry.lesson.id]) {
      begin.querySelector<HTMLElement>("[data-resume]")?.removeAttribute("hidden");
      open.textContent = "Carry on at the altar";
    }
    open.addEventListener("click", async () => {
      if (!entry) return;
      open.disabled = true;
      try {
        // The altar loads on first use: reading a lesson never downloads it.
        const { openAltar } = await import("../../altar/scene");
        openAltar(entry, () => {
          open.focus();
          const resumable = loadPractice().runs[entry.lesson.id];
          open.textContent = resumable ? "Carry on at the altar" : "Rehearse at the altar";
          begin.querySelector<HTMLElement>("[data-resume]")?.toggleAttribute("hidden", !resumable);
        });
      } finally {
        open.disabled = false;
      }
    });
  }
</script>

<style>
  .crumb {
    color: var(--mist);
    font-size: 0.9rem;
  }
  .meta {
    color: var(--glow);
  }
  .lede {
    font-size: 1.1rem;
  }
  .begin {
    margin: 1.5rem 0;
    text-align: center;
  }
  .begin-button {
    min-height: 52px;
    padding: 12px 28px;
    border: 0;
    border-radius: 999px;
    background: var(--glow);
    color: var(--night);
    font: inherit;
    font-weight: 700;
    font-size: 1.1rem;
    cursor: pointer;
  }
  .begin-note {
    color: var(--mist);
    font-size: 0.9rem;
  }
  .read-title {
    font-size: 1.2rem;
  }
  @media print {
    :global(.site-header),
    :global(.site-footer),
    .begin {
      display: none;
    }
  }
  .draft-note {
    padding: 14px 18px;
    border-radius: 14px;
    background: rgb(42 22 80 / 0.6);
  }
  .safety {
    margin: 1rem 0;
    padding: 14px 18px;
    border-radius: 14px;
    border-left: 4px solid var(--glow);
    background: rgb(246 217 122 / 0.08);
  }
  .safety ul {
    margin: 0.4rem 0 0;
  }
  .herb.do-not-use {
    color: #ff9d9d;
    font-weight: 700;
  }
  .steps li {
    margin-bottom: 1rem;
  }
  .prompt {
    margin: 0;
    font-weight: 600;
  }
  .why {
    margin: 0.2rem 0 0;
    color: var(--mist);
    font-style: italic;
  }
</style>
