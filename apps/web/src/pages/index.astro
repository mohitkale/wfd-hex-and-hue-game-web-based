---
import Page from "../layouts/Page.astro";
import { SITE, absolute, artUrl, gallery } from "../lib/site";

const chapters = gallery();
const blurbs: Record<string, string> = {
  "chapter-1": "A first candle, a hat that does not fit yet, a broom and a black cat.",
  "chapter-2": "Lavender, mortar and pestle, a mandrake and your first brew.",
  "chapter-3": "Quartz and amethyst, a crystal ball and a grid to charge them.",
  "chapter-4": "A crescent, the triple moon, an owl and the sky in still water.",
  "chapter-5": "A toad, a raven, a spider's web and the lantern of Samhain.",
  "chapter-6": "The pentacle, the Star, the turning year and your own grimoire.",
};
// The last picture of every other chapter, then the first: a taste of the whole journey.
const strip = [
  chapters[0]!.items[3]!,
  chapters[2]!.items[3]!,
  chapters[4]!.items[3]!,
  chapters[3]!.items[1]!,
  chapters[5]!.items[3]!,
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: SITE.fullName,
  description: SITE.description,
  url: absolute("/", Astro.site),
  image: absolute("/og.png", Astro.site),
  genre: ["Puzzle", "Casual"],
  gamePlatform: "Web browser",
  applicationCategory: "Game",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Page title={`${SITE.fullName}, free in your browser`} jsonLd={jsonLd}>
  <section class="hero">
    <div class="moon" aria-hidden="true"></div>
    <h1>Hex &amp; Hue</h1>
    <p class="tagline">{SITE.tagline}</p>
    <p class="lede">
      Pick a box and your familiars set off to fetch every cube of its colour, one by one, until the
      picture is revealed. Walk a witch's journey of 24 pictures, from a first candle to your own
      grimoire. A cozy pixel puzzle you can play anywhere, for free.
    </p>
    <div class="ctas">
      <a class="cta" href="/play/">
        Play now, free
      </a>
      <a class="cta secondary" href="/spellbook/">
        Browse the Spellbook
      </a>
    </div>
    <ul class="strip" aria-label="Some of the pictures you will reveal">
      {strip.map((item) => (
        <li>
          <img class="pixel" src={artUrl(item.id)} alt={item.name} width="96" height="96" />
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>How to play</h2>
    <ol class="steps">
      <li>
        <strong>Pick a box</strong>
        <span>
          It moves into a tray, and your familiars (a bat, a cat, an owl…) come out of it.
        </span>
      </li>
      <li>
        <strong>Watch them fetch</strong>
        <span>
          Each familiar fetches one cube of the box's colour from the edge of the picture and
          carries it into the hole. Choose well: a box whose colour is still buried waits, and when
          every tray waits, you are stuck.
        </span>
      </li>
      <li>
        <strong>Reveal the art</strong>
        <span>
          Clear every cube and the finished picture blooms into your Spellbook, with a little lore
          to keep.
        </span>
      </li>
    </ol>
  </section>

  <section>
    <h2>Made to never get in your way</h2>
    <ul class="promises">
      <li>
        <strong>Free forever.</strong> No energy, no lives, no timers, no paywalled levels.
      </li>
      <li>
        <strong>Retry is always free</strong> and instant; every booster can be earned by playing.
      </li>
      <li>
        <strong>Plays offline</strong> and installs like an app on your phone.
      </li>
      <li>
        <strong>Comfortable for everyone:</strong> color symbols, reduced motion and volume
        controls.
      </li>
      <li>
        <strong>Original art and lore</strong>, made for the witchy and the starry-eyed.
      </li>
    </ul>
  </section>

  <section>
    <h2>Six chapters of a witch's journey</h2>
    <div class="worlds">
      {chapters.map((w) => (
        <article class="world">
          <div class="thumbs">
            {w.items.slice(0, 3).map((item) => (
              <img
                class="pixel"
                src={artUrl(item.id)}
                alt={item.name}
                width="72"
                height="72"
                loading="lazy"
              />
            ))}
          </div>
          <h3>{w.name}</h3>
          <p>{blurbs[w.id]}</p>
          <p class="count">{w.items.length} pictures, easy to extreme</p>
        </article>
      ))}
    </div>
  </section>

  <section class="final">
    <p>Ready for a little magic?</p>
    <a class="cta" href="/play/">
      Start playing
    </a>
  </section>
</Page>

<style>
  .hero {
    text-align: center;
    padding: 24px 0 8px;
    background: radial-gradient(circle at 50% 10%, rgb(42 22 80 / 0.9), transparent 70%);
  }
  .moon {
    width: 56px;
    height: 56px;
    margin: 0 auto 12px;
    border-radius: 50%;
    box-shadow:
      inset -14px 0 0 0 var(--glow),
      0 0 40px 6px rgb(246 217 122 / 0.25);
  }
  .tagline {
    color: var(--glow);
    margin: 0 0 1rem;
    font-size: 1.15rem;
  }
  .hero .lede {
    margin: 0 auto;
  }
  .ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin: 1.5rem 0;
  }
  .cta {
    display: inline-block;
    padding: 0.9rem 2rem;
    border-radius: 999px;
    background: var(--glow);
    color: var(--night) !important;
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
  }
  .cta.secondary {
    background: var(--dusk);
    color: var(--text) !important;
  }
  .strip {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }
  .strip img {
    width: 96px;
    height: 96px;
    object-fit: contain;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps li {
    counter-increment: step;
    padding: 20px;
    border-radius: 20px;
    background: rgb(42 22 80 / 0.6);
    display: grid;
    gap: 6px;
  }
  .steps li::before {
    content: counter(step);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--glow);
    color: var(--night);
    font-weight: 700;
  }
  .steps span {
    color: var(--mist);
  }
  .promises {
    padding-left: 1.2rem;
    max-width: 42rem;
  }
  .promises li {
    margin: 0.4rem 0;
  }
  .worlds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .world {
    padding: 20px;
    border-radius: 20px;
    background: rgb(42 22 80 / 0.6);
  }
  .world h3 {
    margin: 12px 0 4px;
  }
  .world p {
    margin: 0;
    color: var(--mist);
  }
  .world .count {
    margin-top: 8px;
    color: var(--glow);
    font-size: 0.9rem;
  }
  .thumbs {
    display: flex;
    gap: 8px;
  }
  .thumbs img {
    width: 72px;
    height: 72px;
    object-fit: contain;
  }
  .final {
    text-align: center;
    margin-top: 3rem;
  }
  .final p {
    font-size: 1.3rem;
  }
</style>
