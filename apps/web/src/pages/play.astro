---
import Base from "../layouts/Base.astro";
---

<Base title="Play · Hex & Hue" zoomable={false}>
  <div id="game"></div>
</Base>

<script>
  import { mountGame } from "@hexhue/game";

  const parent = document.getElementById("game");
  if (parent) {
    mountGame(parent).canvas?.setAttribute("aria-label", "Hex & Hue game");
  }
</script>

<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  #game {
    position: fixed;
    /* Full-bleed and unpadded: Phaser sizes the canvas from the parent box and ignores padding.
       Safe-area insets are handled inside the game layout. */
    inset: 0;
  }
  #game canvas {
    display: block;
  }
</style>
