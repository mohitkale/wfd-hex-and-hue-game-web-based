---
interface Props {
  title: string;
  description?: string;
  /** Pinch-zoom stays on for content pages; only the game disables it. */
  zoomable?: boolean;
  /** Registers the offline service worker (the game page only; see pwa/client.ts). */
  offline?: boolean;
}
const {
  title,
  zoomable = true,
  offline = false,
  description = "A free magical color-sorting pixel puzzle. A Little Magic in Every Color.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content={`width=device-width, initial-scale=1, viewport-fit=cover${zoomable ? "" : ", maximum-scale=1, user-scalable=no"}`}
    />
    <meta name="theme-color" content="#140b2e" />
    <meta name="description" content={description} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
  </head>
  <body data-offline={offline ? "" : undefined}>
    <slot />
    <script>
      import { setupPwa } from "../pwa/client";
      setupPwa();
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  :root {
    color-scheme: dark;
    --night: #140b2e;
    --dusk: #2a1650;
    --glow: #f6d97a;
    --mist: #c9b8ff;
    --text: #f5efff;
  }
  /* PWA update banner (pwa/client.ts): top center, clear of the thumb-zone controls. */
  .hh-toast {
    position: fixed;
    z-index: 100;
    top: calc(env(safe-area-inset-top) + 12px);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: calc(100vw - 32px);
    padding: 8px 8px 8px 16px;
    border: 1px solid rgb(246 217 122 / 0.6);
    border-radius: 999px;
    background: var(--dusk);
    color: var(--text);
    font-size: 14px;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.4);
  }
  .hh-toast button {
    min-height: 36px;
    padding: 0 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--mist);
    font: inherit;
    cursor: pointer;
  }
  .hh-toast button.hh-toast-primary {
    background: var(--glow);
    color: var(--night);
    font-weight: 700;
  }
  html,
  body {
    margin: 0;
    background: var(--night);
    color: var(--text);
    font-family:
      system-ui,
      -apple-system,
      "Segoe UI",
      Roboto,
      sans-serif;
  }
</style>
